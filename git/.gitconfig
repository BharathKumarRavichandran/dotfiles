[user]
	email = bharathkumarravichandran@gmail.com
	name = BharathKumarRavichandran
	editor = vim
	signingkey = A711450E8E510AD9!
[credential]
	helper = cache --timeout 72000
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
[commit]
	gpgsign = true
[gpg]
	program = gpg
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
