[user]
	email = bharathkumarravichandran@gmail.com
	name = BharathKumarRavichandran
	editor = vim
	signingkey = A711450E8E510AD9!
[credential]
	helper = cache --timeout 72000
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[commit]
	gpgsign = true
[gpg]
	program = gpg
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = false
	line-numbers = true
