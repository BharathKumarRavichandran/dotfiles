#!/bin/bash
# Print a compact battery status indicator for use in a shell prompt.

if [[ "$(uname)" == "Darwin" ]]; then
  battstat=$(pmset -g batt)
  time_left=$(echo "$battstat" |
    tail -1 |
    cut -f2 |
    awk -F"; " '{print $3}' |
    cut -d' ' -f1
  )

  if [[ $(pmset -g ac) == *"No adapter attached."* ]]
  then
    emoji='🔋'
  else
    emoji='🔌'
  fi
elif command -v acpi > /dev/null
then
  battstat=$(acpi -b | head -1)

  if [[ "$battstat" == *"Discharging"* ]]
  then
    emoji='🔋'
  else
    emoji='🔌'
  fi

  time_left=$(echo "$battstat" | grep -oE '[0-9]+:[0-9]{2}:[0-9]{2}' | awk -F: '{printf "%d:%02d", $1, $2}')
else
  printf ""
  exit 0
fi

if [[ $time_left == *"(no"* || $time_left == *"not"* || -z $time_left ]]
then
  time_left='⌛️ '
fi

if [[ $time_left == *"0:00"* ]]
then
  time_left='⚡️ '
fi

printf '\033[1;92m%s  %s \033[0m' "$emoji" "$time_left"
