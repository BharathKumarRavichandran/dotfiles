#!/bin/bash
# Synchronize the contents of one directory into another with rsync.

set -e

if [ "$#" -lt 2 ]; then
    echo "Usage: sync-dirs [rsync_options...] <source_dir> <destination_dir>" >&2
    exit 2
fi

args=("$@")
source_dir=${args[$# - 2]}
destination_dir=${args[$# - 1]}
options=("${args[@]:0:$# - 2}")

if [ ! -d "$source_dir" ]; then
    echo "sync-dirs: source is not a directory: $source_dir" >&2
    exit 1
fi

if [ -e "$destination_dir" ] && [ ! -d "$destination_dir" ]; then
    echo "sync-dirs: destination is not a directory: $destination_dir" >&2
    exit 1
fi

mkdir -p "$destination_dir"
source_dir=$(cd -- "$source_dir" && pwd -P)
destination_dir=$(cd -- "$destination_dir" && pwd -P)

if [[ $source_dir == / || $destination_dir == / ||
      $source_dir == "$destination_dir" ||
      $source_dir == "$destination_dir/"* ||
      $destination_dir == "$source_dir/"* ]]; then
    echo "sync-dirs: source and destination must not overlap" >&2
    exit 1
fi

echo "Syncing:"
echo "  Source:      $source_dir"
echo "  Destination: $destination_dir"
echo

if rsync -avh --progress "${options[@]}" -- "$source_dir/" "$destination_dir/"; then
    echo
    echo "Sync completed successfully."
else
    echo
    echo "Sync failed."
    exit 1
fi
