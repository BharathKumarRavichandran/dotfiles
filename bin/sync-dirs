#!/bin/bash

if [ "$#" -lt 2 ]; then
    echo "Usage: $0 [rsync_options...] <source_dir> <destination_dir>"
    exit 1
fi

# macOS ships bash 3.2 as /bin/bash (no negative array indices), so this
# sticks to positional-parameter slicing rather than "${array[-1]}".
# shellcheck disable=SC2124
SRC="${@: -2:1}"
# shellcheck disable=SC2124
DST="${@: -1}"
OPTIONS=("${@:1:$(($#-2))}")

if [ ! -d "$SRC" ]; then
    echo "Error: Source directory does not exist: $SRC"
    exit 1
fi

if [ ! -d "$DST" ]; then
    echo "Destination directory does not exist. Creating: $DST"
    mkdir -p "$DST" || exit 1
fi

echo "Syncing:"
echo "  Source:      $SRC"
echo "  Destination: $DST"
echo "  Options:     -avh --progress ${OPTIONS[*]}"
echo

if rsync -avh --progress "${OPTIONS[@]}" -- "$SRC/" "$DST/"; then
    echo
    echo "Sync completed successfully."
else
    echo
    echo "Sync failed."
    exit 1
fi