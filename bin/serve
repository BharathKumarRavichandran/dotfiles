#!/usr/bin/env sh
# Serve a directory over HTTP with Python.

set -e

usage() {
    echo "Usage: serve [directory] [port]" >&2
    echo "       serve <port>" >&2
}

if [ "$#" -gt 2 ]; then
    usage
    exit 2
fi

directory=.
port=

if [ "$#" -eq 1 ]; then
    case $1 in
        *[!0-9]*) directory=$1 ;;
        *) port=$1 ;;
    esac
elif [ "$#" -eq 2 ]; then
    directory=$1
    port=$2
fi

if command -v python3 >/dev/null 2>&1; then
    python=python3
elif command -v python >/dev/null 2>&1 && python -c 'import http.server' 2>/dev/null; then
    python=python
else
    echo "serve: Python 3 is required" >&2
    exit 1
fi

if [ ! -d "$directory" ]; then
    echo "serve: not a directory: $directory" >&2
    exit 1
fi

if [ -z "$port" ]; then
    port=$($python -c 'import random, socket
ports = list(range(8000, 9001))
random.shuffle(ports)
for port in ports:
    with socket.socket() as sock:
        try:
            sock.bind(("", port))
        except OSError:
            continue
        print(port)
        break
else:
    raise SystemExit("serve: no available port between 8000 and 9000")') || exit 1
fi

case $port in
    ''|*[!0-9]*) usage; exit 2 ;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "serve: port must be between 1 and 65535" >&2
    exit 2
fi

echo "Serving $directory at http://localhost:$port"
exec "$python" -m http.server "$port" --directory "$directory"
