#!/usr/bin/env bash
# Enable an Apache virtual host by linking its configuration.

set -e

available_dir=${APACHE_SITES_AVAILABLE:-/etc/httpd/conf/sites-available}
enabled_dir=${APACHE_SITES_ENABLED:-/etc/httpd/conf/sites-enabled}

usage() {
    echo "Usage: a2ensite <site>" >&2
    if [[ -d $available_dir ]]; then
        echo "Available sites:" >&2
        find "$available_dir" -maxdepth 1 -type f -name '*.conf' -exec basename {} .conf \; | sort >&2
    fi
}

if [[ $# -ne 1 || -z $1 ]]; then
    usage
    exit 2
fi

site=${1%.conf}
if [[ -z $site || $site == */* || $site == . || $site == .. ]]; then
    echo "a2ensite: invalid site name: $1" >&2
    exit 2
fi
available="$available_dir/$site.conf"
enabled="$enabled_dir/$site.conf"

if [[ ! -f $available ]]; then
    echo "a2ensite: site does not exist: $available" >&2
    usage
    exit 1
fi

sudo mkdir -p "$enabled_dir"
if [[ -L $enabled && $(readlink "$enabled") == "$available" ]]; then
    echo "$site is already enabled"
    exit 0
fi
if [[ -e $enabled || -L $enabled ]]; then
    echo "a2ensite: destination already exists: $enabled" >&2
    exit 1
fi

sudo ln -s "$available" "$enabled"
echo "Enabled $site. Restart Apache to apply the change."
