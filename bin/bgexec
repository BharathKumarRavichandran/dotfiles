#!/usr/bin/env bash
# Run a command silently in the background and detach it from the shell.

if [[ $# -eq 0 ]]; then
    echo "Usage: bgexec <command> [args...]" >&2
    exit 1
fi

if ! command -v "$1" &> /dev/null
then
    echo "bgexec: command not found: $1" >&2
    exit 1
fi

echo "Opening $1..."
nohup "$@" </dev/null >/dev/null 2>&1 &
