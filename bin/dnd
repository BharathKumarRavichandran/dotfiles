#!/usr/bin/env bash
# Enable or disable Do Not Disturb on macOS or Linux.

getargs() {
  while getopts "se" opt
  do
    case $opt in
      s) start="true";;
      e) end="true";;
      *) ;;
    esac
  done
}

start_dnd() {
  if [[ "$(uname)" == "Darwin" ]]
  then
    shortcuts run "Enable DND"
  else
    notify-send "DUNST_COMMAND_PAUSE";
  fi
  echo "DND enabled"
}

end_dnd() {
  if [[ "$(uname)" == "Darwin" ]]
  then
    shortcuts run "Disable DND"
  else
    notify-send "DUNST_COMMAND_RESUME";
    notify-send "Do Not Disturb" "DND disabled. Notifications will be shown.";
  fi
  echo "DND disabled"
}

main() {
  getargs "$@";
  [[ "$start" ]] && start_dnd;
  [[ "$end" ]] && end_dnd;
}
main "$@"
