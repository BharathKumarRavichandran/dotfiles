#!/usr/bin/env bash

set -e

status=0
sh_files=()
zsh_files=()
json_files=()
validate_repo=0

while IFS= read -r -d '' file; do
    [[ $file == configure.sh || $file == homebrew/Brewfile.* || $file == packages/*.lst ]] && validate_repo=1
    case $file in
        bin/dotfiles-doctor|bin/dotfiles-update|packages/install.sh|install.sh|bootstrap.sh|tests/repo-validation.sh)
            zsh_files+=("$file")
            ;;
        bin/*|conky/conky-start.sh|polybar/launch.sh|polybar/preview.sh|polybar/scripts/launcher.sh|polybar/scripts/powermenu.sh|polybar/scripts/style-switch.sh|polybar/scripts/styles.sh|polybar/scripts/updates.sh)
            sh_files+=("$file")
            ;;
        configure.sh|*/setup.sh|tests/setup-smoke.sh|*.zsh)
            zsh_files+=("$file")
            ;;
        *.json)
            [[ $file == vscode/settings.json || $file == vscode/keybindings.json ]] || json_files+=("$file")
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if (( ${#sh_files[@]} )); then
    if command -v shellcheck >/dev/null; then
        echo "Running ShellCheck..."
        shellcheck "${sh_files[@]}" || status=1
    else
        echo "shellcheck not found, skipping shell checks" >&2
    fi
fi

if (( ${#zsh_files[@]} )); then
    echo "Checking Zsh syntax..."
    for f in "${zsh_files[@]}"; do
        zsh -n "$f" || status=1
    done
fi

if (( ${#json_files[@]} )); then
    if command -v jq >/dev/null; then
        echo "Validating staged JSON files..."
        for f in "${json_files[@]}"; do
            jq empty "$f" || status=1
        done
    else
        echo "jq not found, skipping JSON validation" >&2
    fi
fi

if (( validate_repo )); then
    echo "Validating profiles and package manifests..."
    zsh tests/repo-validation.sh || status=1
fi

exit $status
